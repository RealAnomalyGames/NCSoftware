{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Node",
        "strict": true,
        "rootDir": ".",
        "outDir": ".",
        "sourceMap": true,
        "removeComments": false,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": [
        "engine/**/*.ts",
        "editor/**/*.ts",
        "runtime/**/*.ts"
    ]
}
