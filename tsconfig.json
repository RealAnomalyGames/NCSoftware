{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,

    "rootDir": ".",
    "outDir": "dist",

    "sourceMap": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },

  "include": [
    "engine/**/*.ts",
    "editor/**/*.ts",
    "runtime/**/*.ts"
  ]
}